{
  "$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
  "files": { "includes": ["src/**/*.ts", "src/**/*.tsx"] },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useSemanticElements": "off",
        "noStaticElementInteractions": "off",
        "useValidAnchor": "off"
      }
    }
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 }
}
